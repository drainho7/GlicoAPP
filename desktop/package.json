{
    "name":  "glico-desktop",
    "version":  "1.2.3",
    "description":  "Glico - controle de glicemia",
    "author":  "Glico",
    "main":  "main.js",
    "private":  true,
    "scripts":  {
                    "prepare-web":  "node scripts/prepare.js",
                    "start":  "npm run prepare-web \u0026\u0026 electron .",
                    "dist":  "npm run prepare-web \u0026\u0026 electron-builder --win nsis --publish never"
                },
    "build":  {
                  "appId":  "com.glico.desktop",
                  "productName":  "Glico",
                  "directories":  {
                                      "output":  "release",
                                      "buildResources":  "build"
                                  },
                  "files":  [
                                "main.js",
                                "preload.js",
                                "pdf.js",
                                "dist/**"
                            ],
                  "win":  {
                              "target":  "nsis",
                              "icon":  "build/icon.png"
                          },
                  "nsis":  {
                               "oneClick":  false,
                               "allowToChangeInstallationDirectory":  true,
                               "createDesktopShortcut":  true,
                               "shortcutName":  "Glico",
                               "artifactName":  "Glico-Setup-${version}.${ext}"
                           },
                  "publish":  [
                                  {
                                      "provider":  "github",
                                      "owner":  "drainho7",
                                      "repo":  "GlicoAPP",
                                      "releaseType":  "release"
                                  }
                              ]
              },
    "devDependencies":  {
                            "electron":  "^45.3.2",
                            "electron-builder":  "^26.18.0"
                        },
    "dependencies":  {
                         "electron-updater":  "^6.8.11"
                     }
}